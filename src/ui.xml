<interface>
  <object class="GtkWindow" id="window">
    <property name="title">Relay</property>
    <property name="default-width">850</property>
    <property name="default-height">500</property>
    <child type="titlebar">
      <object class="GtkHeaderBar">
        <property name="show-title-buttons">false</property>
        <style><class name="chrome"/></style>
        <property name="title-widget"><object class="GtkLabel"><property name="label">Relay</property></object></property>
        <child type="start"><object class="GtkButton" id="add"><property name="label">＋ Add</property></object></child>
        <child type="end">
          <object class="GtkBox">
            <property name="spacing">8</property>
            <child><object class="GtkButton" id="min"><property name="tooltip-text">Minimize</property><style><class name="dot"/><class name="yellow"/></style></object></child>
            <child><object class="GtkButton" id="max"><property name="tooltip-text">Maximize or restore</property><style><class name="dot"/><class name="green"/></style></object></child>
            <child><object class="GtkButton" id="close"><property name="tooltip-text">Close</property><style><class name="dot"/><class name="red"/></style></object></child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <style><class name="shell"/></style>
        <child><object class="GtkBox"><property name="spacing">7</property>
          <child><object class="GtkLabel"><property name="label">Direct downloads</property><property name="hexpand">true</property><style><class name="pill"/></style></object></child>
          <child><object class="GtkButton" id="torrents"><property name="label">Torrents</property></object></child>
        </object></child>
        <child><object class="GtkScrolledWindow">
          <property name="vexpand">true</property>
          <property name="min-content-height">190</property>
          <style><class name="panel"/></style>
          <child><object class="GtkListBox" id="list"><property name="selection-mode">single</property></object></child>
        </object></child>
        <child><object class="GtkLabel" id="status"><property name="xalign">0</property><property name="wrap">true</property><style><class name="muted"/></style></object></child>
        <child><object class="GtkBox"><property name="spacing">6</property>
          <child><object class="GtkButton" id="pause"><property name="label">Pause</property></object></child>
          <child><object class="GtkButton" id="resume"><property name="label">Resume</property></object></child>
          <child><object class="GtkButton" id="replace"><property name="label">Update link</property></object></child>
          <child><object class="GtkButton" id="restart"><property name="label">Restart</property></object></child>
          <child><object class="GtkButton" id="remove"><property name="label">Remove</property></object></child>
          <child><object class="GtkLabel"><property name="hexpand">true</property></object></child>
          <child><object class="GtkButton" id="check"><property name="label">Check updates</property></object></child>
          <child><object class="GtkButton" id="update"><property name="label">Update now</property></object></child>
        </object></child>
      </object>
    </child>
  </object>
</interface>
